# Generate these 3 different secrets as documented in README.md. Do not commit .env.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
CRON_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS
# SQLite only for local development. On Render use the Supabase Postgres SESSION pooler URI.
DATABASE_URL=sqlite:///./autonomousjobseeker.db
APP_BASE_URL=http://127.0.0.1:8000
SESSION_HTTPS_ONLY=false
# New accounts require this invite code. Set a strong secret for any public deployment.
REGISTRATION_INVITE_CODE=REPLACE_WITH_PRIVATE_INVITE
# Create a Google Cloud OAuth "Web application"; enable Gmail API and set redirect /gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Must be 1 for personal pilot; do not enable public access before security review.
ENABLE_CRON=true
